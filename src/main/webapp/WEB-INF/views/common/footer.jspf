<%@ page pageEncoding="UTF-8" %>
<!-- Footer -->
<footer class="footer">
  <div class="footer-content">
    <!-- About Section -->
    <div class="footer-section">
      <h3>Về UTE Phone Hub</h3>
      <ul>
        <li><a href="${pageContext.request.contextPath}/about">Giới thiệu</a></li>
        <li><a href="${pageContext.request.contextPath}/careers">Tuyển dụng</a></li>
        <li><a href="${pageContext.request.contextPath}/contact">Liên hệ</a></li>
        <li><a href="${pageContext.request.contextPath}/news">Tin tức</a></li>
      </ul>
    </div>

    <!-- Customer Support Section -->
    <div class="footer-section">
      <h3>Hỗ trợ khách hàng</h3>
      <ul>
        <li><a href="${pageContext.request.contextPath}/guide">Hướng dẫn mua hàng</a></li>
        <li><a href="${pageContext.request.contextPath}/warranty">Chính sách bảo hành</a></li>
        <li><a href="${pageContext.request.contextPath}/return">Chính sách đổi trả</a></li>
        <li><a href="${pageContext.request.contextPath}/faq">Câu hỏi thường gặp</a></li>
      </ul>
    </div>

    <!-- Services Section -->
    <div class="footer-section">
      <h3>Dịch vụ</h3>
      <ul>
        <li><a href="${pageContext.request.contextPath}/repair">Sửa chữa điện thoại</a></li>
        <li><a href="${pageContext.request.contextPath}/trade-in">Thu cũ đổi mới</a></li>
        <li><a href="${pageContext.request.contextPath}/extended-warranty">Bảo hành mở rộng</a></li>
        <li><a href="${pageContext.request.contextPath}/software">Cài đặt phần mềm</a></li>
      </ul>
    </div>

    <!-- Contact Section -->
    <div class="footer-section">
      <h3>Liên hệ</h3>
      <ul>
        <li>
          <i class="fas fa-phone"></i> Hotline: <a href="tel:18001234">1800.1234</a>
        </li>
        <li>
          <i class="fas fa-envelope"></i> Email: <a href="mailto:support@utephonehub.com">support@utephonehub.com</a>
        </li>
        <li>
          <i class="fas fa-map-marker-alt"></i> 
          01 Võ Văn Ngân, Linh Chiểu, Thủ Đức, TP.HCM
        </li>
        <li>
          <i class="fas fa-clock"></i> 8:00 - 22:00 (Thứ 2 - Chủ nhật)
        </li>
      </ul>

      <!-- Social Media -->
      <div class="footer-social">
        <a href="https://facebook.com" target="_blank" rel="noopener noreferrer">
          <i class="fab fa-facebook"></i>
        </a>
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer">
          <i class="fab fa-instagram"></i>
        </a>
        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer">
          <i class="fab fa-youtube"></i>
        </a>
        <a href="https://twitter.com" target="_blank" rel="noopener noreferrer">
          <i class="fab fa-twitter"></i>
        </a>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <div class="footer-bottom-content">
      <p>&copy; 2025 UTE Phone Hub. Tất cả quyền được bảo lưu.</p>
      <div class="footer-links">
        <a href="${pageContext.request.contextPath}/terms">Điều khoản sử dụng</a>
        <span>|</span>
        <a href="${pageContext.request.contextPath}/privacy">Chính sách bảo mật</a>
        <span>|</span>
        <a href="${pageContext.request.contextPath}/payment">Phương thức thanh toán</a>
      </div>
    </div>
  </div>
</footer>

<!-- Footer Styles -->
<style>
.footer {
  background: linear-gradient(135deg, #2c3e50, #34495e);
  color: var(--text-white);
  padding: var(--spacing-xxl) 0 0;
  margin-top: var(--spacing-xxl);
}

.footer-content {
  max-width: var(--container-xl);
  margin: 0 auto;
  padding: 0 var(--spacing-lg);
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: var(--spacing-xl);
  margin-bottom: var(--spacing-xl);
}

.footer-section h3 {
  font-size: var(--font-lg);
  font-weight: var(--font-bold);
  margin-bottom: var(--spacing-md);
  color: var(--text-white);
}

.footer-section ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-section ul li {
  margin-bottom: var(--spacing-sm);
}

.footer-section ul li a {
  color: rgba(255, 255, 255, 0.8);
  text-decoration: none;
  transition: color var(--transition-base);
  font-size: var(--font-sm);
}

.footer-section ul li a:hover {
  color: var(--primary-color);
}

.footer-section ul li i {
  margin-right: var(--spacing-sm);
  color: var(--primary-color);
  width: 20px;
}

.footer-social {
  display: flex;
  gap: var(--spacing-md);
  margin-top: var(--spacing-md);
}

.footer-social a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.1);
  color: var(--text-white);
  font-size: var(--font-lg);
  transition: all var(--transition-base);
}

.footer-social a:hover {
  background: var(--primary-color);
  transform: translateY(-3px);
}

.footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  padding: var(--spacing-lg) 0;
}

.footer-bottom-content {
  max-width: var(--container-xl);
  margin: 0 auto;
  padding: 0 var(--spacing-lg);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--spacing-md);
}

.footer-bottom-content p {
  margin: 0;
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.7);
}

.footer-links {
  display: flex;
  gap: var(--spacing-md);
  align-items: center;
  font-size: var(--font-sm);
}

.footer-links a {
  color: rgba(255, 255, 255, 0.7);
  text-decoration: none;
  transition: color var(--transition-base);
}

.footer-links a:hover {
  color: var(--primary-color);
}

.footer-links span {
  color: rgba(255, 255, 255, 0.3);
}

/* Responsive */
@media (max-width: 768px) {
  .footer-content {
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
  }

  .footer-bottom-content {
    flex-direction: column;
    text-align: center;
  }

  .footer-links {
    flex-wrap: wrap;
    justify-content: center;
  }
}
</style>

<!-- Global JavaScript -->
<script>
  // Global context path
  const contextPath = '${pageContext.request.contextPath}';
</script>
<script src="${pageContext.request.contextPath}/static/js/utils.js"></script>
<script src="${pageContext.request.contextPath}/static/js/api.js"></script>
<script src="${pageContext.request.contextPath}/static/js/cart.js"></script>
<script src="${pageContext.request.contextPath}/static/js/main.js"></script>
<script src="${pageContext.request.contextPath}/static/js/auth.js"></script>

