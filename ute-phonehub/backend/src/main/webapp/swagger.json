{
  "openapi": "3.0.3",
  "info": {
    "title": "UTE PhoneHub API",
    "version": "1.0.0",
    "description": "API Documentation for UTE PhoneHub E-commerce Platform",
    "contact": {
      "name": "UTE PhoneHub Team",
      "email": "support@utephonehub.com"
    }
  },
  "servers": [
    {
      "url": "/ute-phonehub",
      "description": "Development server"
    }
